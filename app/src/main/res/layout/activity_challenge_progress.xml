<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE6"
    android:fitsSystemWindows="true">

    <!-- ===================================================== -->
    <!-- BACKGROUND -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- MAIN SCROLL AREA -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/progressScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/progressContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/progressHeader"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardBackgroundColor="#783911"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileContainer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="#F4EFE6"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:contentDescription="Profile"
                            app:tint="#783911" />

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:id="@+id/userInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/profileContainer"
                        app:layout_constraintEnd_toStartOf="@id/pointsInfo"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/usernameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Username"
                            android:textColor="#FFF9F0"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Keep going."
                            android:textColor="#E9D8C8"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pointsInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/pointsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="125 points"
                            android:textColor="#FFF9F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="YOUR SCORE"
                            android:textColor="#DABDA7"
                            android:textSize="8sp"
                            android:letterSpacing="0.12" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- BACK -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:text="←  BACK TO CHALLENGES"
                android:textColor="#783911"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR JOURNEY"
                    android:textColor="#9B7054"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/challengeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hiking Challenge"
                    android:textColor="#293126"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/challengeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Leave the noise behind. Find the silence that's actually full."
                    android:textColor="#6E6A61"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- OVERALL PROGRESS -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/overallProgressCard"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#244316"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/progressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHALLENGE PROGRESS"
                        android:textColor="#BFC9B7"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- This value will be animated from Java -->
                    <TextView
                        android:id="@+id/progressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FFF9F0"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/overallProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="9dp"
                        android:layout_marginTop="15dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#F4EFE6"
                        android:backgroundTint="#506542"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressLabel" />

                    <TextView
                        android:id="@+id/progressTaskCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 of 4 tasks completed"
                        android:textColor="#D8DFD3"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/ongoingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●  ONGOING"
                        android:textColor="#E7E9E2"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- YOUR TASKS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/tasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEEP MOVING"
                        android:textColor="#9B7054"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your Tasks"
                        android:textColor="#293126"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/unlockedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL UNLOCKED"
                    android:textColor="#596447"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- TASK 1 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/taskCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#34472B"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/taskNumber1"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#506542"
                        android:gravity="center"
                        android:text="01"
                        android:textColor="#F4EFE6"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/taskText1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/taskNumber1"
                        app:layout_constraintEnd_toStartOf="@id/taskCamera1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/taskTitle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Find a Trail"
                            android:textColor="#FFF9F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/taskDescription1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Choose a new walking trail you've never explored."
                            android:textColor="#DDE5D8"
                            android:textSize="9sp"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/taskStatus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="NOT STARTED"
                            android:textColor="#F4EFE6"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <!-- CLICKABLE CAMERA BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/taskCamera1"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#F4EFE6"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Take photo for task 1"
                            app:tint="#34472B" />

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- TASK 2 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/taskCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginTop="9dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#463927"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/taskNumber2"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#665237"
                        android:gravity="center"
                        android:text="02"
                        android:textColor="#F4EFE6"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/taskText2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/taskNumber2"
                        app:layout_constraintEnd_toStartOf="@id/taskCamera2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/taskTitle2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Walk 2 Kilometres"
                            android:textColor="#FFF9F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/taskDescription2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Complete a peaceful 2 km walk along your chosen trail."
                            android:textColor="#E5DDD1"
                            android:textSize="9sp"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/taskStatus2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="NOT STARTED"
                            android:textColor="#F4EFE6"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <!-- CLICKABLE CAMERA BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/taskCamera2"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#F4EFE6"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Take photo for task 2"
                            app:tint="#463927" />

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- TASK 3 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/taskCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginTop="9dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#3B4038"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/taskNumber3"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#596057"
                        android:gravity="center"
                        android:text="03"
                        android:textColor="#F4EFE6"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/taskText3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/taskNumber3"
                        app:layout_constraintEnd_toStartOf="@id/taskCamera3"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/taskTitle3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Take a Nature Break"
                            android:textColor="#FFF9F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/taskDescription3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Stop somewhere quiet and spend 5 minutes taking in your surroundings."
                            android:textColor="#DCE0DA"
                            android:textSize="9sp"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/taskStatus3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="NOT STARTED"
                            android:textColor="#F4EFE6"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <!-- CLICKABLE CAMERA BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/taskCamera3"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#F4EFE6"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Take photo for task 3"
                            app:tint="#3B4038" />

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- TASK 4 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/taskCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginTop="9dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#783911"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/taskNumber4"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#92572F"
                        android:gravity="center"
                        android:text="04"
                        android:textColor="#F4EFE6"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/taskText4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/taskNumber4"
                        app:layout_constraintEnd_toStartOf="@id/taskCamera4"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/taskTitle4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Capture the View"
                            android:textColor="#FFF9F0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/taskDescription4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Take one photo of the best view you discover."
                            android:textColor="#E9D8C8"
                            android:textSize="9sp"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/taskStatus4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="NOT STARTED"
                            android:textColor="#F4EFE6"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <!-- CLICKABLE CAMERA BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/taskCamera4"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#F4EFE6"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Take photo for task 4"
                            app:tint="#783911" />

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- EVIDENCE SECTION -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/evidenceCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#E8DED0"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/mainCameraButton"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHOW YOUR PROGRESS"
                            android:textColor="#9B7054"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/evidenceTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Capture your adventure"
                            android:textColor="#293126"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Take a photo as evidence for any task."
                            android:textColor="#6E6A61"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <!-- MAIN CAMERA BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/mainCameraButton"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#783911"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Open camera"
                            app:tint="#F4EFE6" />

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- MOTIVATION -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/motivationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="One step at a time. Keep exploring."
                android:textColor="#783911"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>