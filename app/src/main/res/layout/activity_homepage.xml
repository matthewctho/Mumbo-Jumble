<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE6">

    <!-- BACKGROUND IMAGE -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#783911"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Profile picture"
            android:src="@android:drawable/ic_menu_myplaces"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

        <!-- Username -->
        <TextView
            android:id="@+id/usernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Username"
            android:textColor="#F8F5EE"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Points -->
        <TextView
            android:id="@+id/pointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 points"
            android:textColor="#F8F5EE"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- MAIN CONTENT -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- ONGOING CHALLENGES -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/ongoingChallengesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ongoing Challenges"
            android:textColor="#3F4935"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- ONGOING CHALLENGE CARD -->

        <androidx.cardview.widget.CardView
            android:id="@+id/ongoingChallengeBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#596447"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#244316"
                android:padding="20dp">

                <!-- Small Label -->

                <TextView
                    android:id="@+id/hikingChallengeName5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="&quot;The best frames don't come looking for you — you go looking for them. Pick a corner you've never noticed and give it a reason to be seen.  Start today. Your next shot is out there.&quot;"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#F8F5EE"
                    android:textSize="10sp"
                    android:textStyle="italic"
                    app:layout_constraintTop_toBottomOf="@+id/ongoingLabel"
                    tools:layout_editor_absoluteX="16dp" />

                <TextView
                    android:id="@+id/ongoingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="No challenge waiting? Make one."
                    android:textColor="#DDE0D3"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Challenge Name -->

                <!-- Progress Text -->
                <TextView
                    android:id="@+id/ongoingProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep going!"
                    android:textColor="#E6E7DF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Arrow -->
                <TextView
                    android:id="@+id/ongoingArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#F8F5EE"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================================================= -->
        <!-- NEW CHALLENGES -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/newChallengesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Challenges"
            android:textColor="#3F4935"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />


        <!-- ================================================= -->
        <!-- HORIZONTAL SCROLLING CHALLENGES -->
        <!-- ONE CARD VISIBLE AT A TIME -->
        <!-- ================================================= -->

        <HorizontalScrollView
            android:id="@+id/challengesScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/challengesContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- HIKING -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/hikingChallenge"
                    android:layout_width="365dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#596447"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#244316"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/hikingIcon"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:contentDescription="Hiking icon"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#FF0000" />

                        <TextView
                            android:id="@+id/hikingChallengeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="Hiking"
                            android:textColor="#F8F5EE"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hikingChallengeName2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="&quot;Leave the noise behind, find the silence that's actually full: birdsong, wide views, and a version of you that remembers how to breathe.  Lace up. The mountains have been waiting.&quot;"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textColor="#F8F5EE"
                            android:textSize="10sp"
                            android:textStyle="italic" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ================================================= -->
                <!-- BASKETBALL -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/basketballChallenge"
                    android:layout_width="365dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#596447"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#244316"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/basketballIcon"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:contentDescription="Basketball icon"
                            android:src="@android:drawable/ic_menu_rotate"
                            app:tint="#FF0000" />

                        <TextView
                            android:id="@+id/basketballChallengeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Basketball"
                            android:textColor="#F8F5EE"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hikingChallengeName3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="&quot;Every dribble, every shot, every clutch moment under pressure — this is where you find out what you're made of.  Grab a ball. The game's already started.&quot;"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textColor="#F8F5EE"
                            android:textSize="10sp"
                            android:textStyle="italic" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ================================================= -->
                <!-- PHOTO WALKS -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/photoWalksChallenge"
                    android:layout_width="365dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#596447"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#244316"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/photoWalksIcon"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:contentDescription="Photo walks icon"
                            android:outlineAmbientShadowColor="#070707"
                            android:outlineSpotShadowColor="#000000"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#FF0000" />

                        <TextView
                            android:id="@+id/photoWalksChallengeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Photo Walks"
                            android:textColor="#F8F5EE"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hikingChallengeName4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="&quot;Slow down, look twice, and let the ordinary surprise you the best frame is usually the one you almost walked past.  Grab your camera. The city's waiting to be seen differently.&quot;"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textColor="#F8F5EE"
                            android:textSize="10sp"
                            android:textStyle="italic" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>