<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE6">

    <!-- ============================= -->
    <!-- Decorative background shapes -->
    <!-- ============================= -->

    <View
        android:id="@+id/topGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.18"
        android:background="@drawable/bg_glow_circle"
        android:translationX="100dp"
        android:translationY="-120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.12"
        android:background="@drawable/bg_glow_circle"
        android:translationX="-100dp"
        android:translationY="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ============================= -->
    <!-- Main Card -->
    <!-- ============================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/registerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#FCFAF5"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:strokeColor="#E5DFD2"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="34dp"
            android:paddingBottom="30dp">

            <!-- ============================= -->
            <!-- Header -->
            <!-- ============================= -->

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#34402E"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Register to get started"
                android:textColor="#777467"
                android:textSize="15sp"
                android:gravity="center" />


            <!-- Small accent line -->

            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_accent_line" />


            <!-- ============================= -->
            <!-- Form -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical">


                <!-- Username -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/usernameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#35402F"
                        android:textColorHint="#777467"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Email -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:hint="Email"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#35402F"
                        android:textColorHint="#777467"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Password -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:hint="Password"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/input_icon"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#35402F"
                        android:textColorHint="#777467"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Phone -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:hint="Phone"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="#35402F"
                        android:textColorHint="#777467"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Location -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/locationLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:hint="Location"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/locationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:textColor="#35402F"
                        android:textColorHint="#777467"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ============================= -->
            <!-- Error -->
            <!-- ============================= -->

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#9B3D2E"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="2" />


            <!-- ============================= -->
            <!-- Create Account Button -->
            <!-- ============================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="17dp"
                android:text="CREATE ACCOUNT"
                android:textColor="#FFFDF7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans"
                android:stateListAnimator="@animator/button_state"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                app:backgroundTint="@color/button_selector"
                app:cornerRadius="29dp"
                app:rippleColor="#55FFFFFF"
                />


            <!-- ============================= -->
            <!-- Login -->
            <!-- ============================= -->

            <TextView
                android:id="@+id/loginToggleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="19dp"
                android:padding="8dp"
                android:text="Already have an account?  Log in"
                android:textColor="#657052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

