<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pointsPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE6">

    <!-- ========================================================= -->
    <!-- BACKGROUND -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.12"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pointsToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#783911"
        android:elevation="4dp"
        app:title="Rewards"
        app:titleTextColor="#F8F5EE"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#F8F5EE"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================= -->
    <!-- MAIN SCROLL -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rewardsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/pointsToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp">

            <!-- ================================================= -->
            <!-- GREETING -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/rewardsGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:letterSpacing="0.14"
                android:text="YOUR REWARD WALLET"
                android:textColor="#596447"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rewardsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="You've earned something worth celebrating."
                android:textColor="#3F4935"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- TOTAL POINTS HERO CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/totalPointsCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="16dp"
                android:stateListAnimator="@animator/card_lift"
                app:cardBackgroundColor="#244316"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#596447"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <!-- ================================================= -->
                    <!-- CIRCULAR REWARD PROGRESS -->
                    <!-- ================================================= -->

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/rewardProgressWheel"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:indeterminate="false"
                        android:max="1500"
                        android:progress="1250"
                        app:indicatorColor="#D9A441"
                        app:indicatorSize="110dp"
                        app:trackColor="#596447"
                        app:trackThickness="9dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Percentage displayed inside wheel -->

                    <TextView
                        android:id="@+id/rewardProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="83%"
                        android:textColor="#F8F5EE"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@id/rewardProgressWheel"
                        app:layout_constraintBottom_toBottomOf="@id/rewardProgressWheel"
                        app:layout_constraintStart_toStartOf="@id/rewardProgressWheel"
                        app:layout_constraintEnd_toEndOf="@id/rewardProgressWheel" />

                    <!-- ================================================= -->
                    <!-- POINTS LABEL -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/pointsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="TOTAL POINTS"
                        android:textColor="#DDE0D3"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- ================================================= -->
                    <!-- BIG POINTS NUMBER -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/totalPointsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans"
                        android:text="1,250"
                        android:textColor="#F8F5EE"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pointsLabel" />

                    <!-- ================================================= -->
                    <!-- PTS -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/pointsWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="pts"
                        android:textColor="#D9A441"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/totalPointsText"
                        app:layout_constraintStart_toEndOf="@id/totalPointsText" />

                    <!-- ================================================= -->
                    <!-- NEXT REWARD LABEL -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/nextRewardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250 pts until your next reward"
                        android:textColor="#DDE0D3"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toTopOf="@id/pointsProgress"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- ================================================= -->
                    <!-- HORIZONTAL PROGRESS BAR -->
                    <!-- ================================================= -->

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pointsProgress"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:max="1500"
                        android:progress="1250"
                        android:layout_marginEnd="10dp"
                        app:indicatorColor="#D9A441"
                        app:trackColor="#596447"
                        app:trackCornerRadius="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/pointsProgressPercentage" />

                    <!-- ================================================= -->
                    <!-- PROGRESS PERCENTAGE -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/pointsProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="83%"
                        android:textColor="#F8F5EE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/pointsProgress"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================================================= -->
            <!-- QUICK EARN -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Keep earning"
                    android:textColor="#3F4935"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAllEarning"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="How it works"
                    android:textColor="#783911"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="20dp"
                    app:rippleColor="#22783911"
                    app:strokeColor="#783911"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- EARNING CHIPS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCompleteChallenge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Complete a challenge"
                        android:textColor="#F8F5EE"
                        android:textSize="12sp"
                        app:chipBackgroundColor="#596447"
                        app:chipCornerRadius="18dp"
                        app:chipMinHeight="38dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDailyActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="★ Daily activity"
                        android:textColor="#F8F5EE"
                        android:textSize="12sp"
                        app:chipBackgroundColor="#783911"
                        app:chipCornerRadius="18dp"
                        app:chipMinHeight="38dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="🔥 Build a streak"
                        android:textColor="#3F4935"
                        android:textSize="12sp"
                        app:chipBackgroundColor="#D9A441"
                        app:chipCornerRadius="18dp"
                        app:chipMinHeight="38dp"
                        app:chipStrokeWidth="0dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ================================================= -->
            <!-- REDEEM SHOP HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/redeemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redeem Shop"
                        android:textColor="#3F4935"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/redeemSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Turn your points into something real."
                        android:textColor="#596447"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/rewardsFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Gift Cards"
                    android:textColor="#783911"
                    android:textSize="11sp"
                    app:chipBackgroundColor="#E8DFD0"
                    app:chipCornerRadius="19dp"
                    app:chipStrokeColor="#783911"
                    app:chipStrokeWidth="1dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- REWARD SHOP -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:id="@+id/rewardsHorizontalScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rewardCardsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ================================================= -->
                    <!-- $5 GIFT CARD -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/giftCard5"
                        android:layout_width="220dp"
                        android:layout_height="270dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/card_lift"
                        app:cardBackgroundColor="#F8F5EE"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp"
                        app:rippleColor="#22783911"
                        app:strokeColor="#D9A441"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="112dp"
                                android:background="@drawable/gift_card_background">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="🎁"
                                    android:textSize="46sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="9dp"
                                    android:text="$5"
                                    android:textColor="#783911"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/giftCard5Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="$5 Gift Card"
                                android:textColor="#3F4935"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/giftCard5Cost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="750 points"
                                android:textColor="#783911"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/redeem5Button"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:stateListAnimator="@animator/button_press"
                                android:text="Redeem"
                                android:textAllCaps="false"
                                android:textColor="#F8F5EE"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="#783911"
                                app:cornerRadius="15dp"
                                app:icon="@drawable/ic_arrow_forward"
                                app:iconGravity="textEnd"
                                app:iconPadding="8dp"
                                app:iconTint="#F8F5EE"
                                app:rippleColor="#33FFFFFF" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ================================================= -->
                    <!-- $10 GIFT CARD -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/giftCard10"
                        android:layout_width="220dp"
                        android:layout_height="270dp"
                        android:layout_marginStart="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/card_lift"
                        app:cardBackgroundColor="#F8F5EE"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp"
                        app:rippleColor="#22596447"
                        app:strokeColor="#596447"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="112dp"
                                android:background="@drawable/gift_card_background_green">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="🎁"
                                    android:textSize="46sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="9dp"
                                    android:text="$10"
                                    android:textColor="#F8F5EE"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/giftCard10Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="$10 Gift Card"
                                android:textColor="#3F4935"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/giftCard10Cost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="1,500 points"
                                android:textColor="#596447"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/redeem10Button"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:stateListAnimator="@animator/button_press"
                                android:text="Redeem"
                                android:textAllCaps="false"
                                android:textColor="#F8F5EE"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="#596447"
                                app:cornerRadius="15dp"
                                app:icon="@android:drawable/ic_menu_send"
                                app:iconGravity="textEnd"
                                app:iconPadding="8dp"
                                app:iconTint="#F8F5EE"
                                app:rippleColor="#33FFFFFF" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ================================================= -->
                    <!-- $25 GIFT CARD -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/giftCard25"
                        android:layout_width="220dp"
                        android:layout_height="270dp"
                        android:layout_marginStart="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/card_lift"
                        app:cardBackgroundColor="#F8F5EE"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp"
                        app:rippleColor="#22783911"
                        app:strokeColor="#783911"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="112dp"
                                android:background="@drawable/gift_card_background_brown">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="🎁"
                                    android:textSize="46sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="9dp"
                                    android:text="$25"
                                    android:textColor="#F8F5EE"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/giftCard25Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="$25 Gift Card"
                                android:textColor="#3F4935"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/giftCard25Cost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="3,500 points"
                                android:textColor="#783911"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/redeem25Button"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:stateListAnimator="@animator/button_press"
                                android:text="Redeem"
                                android:textAllCaps="false"
                                android:textColor="#F8F5EE"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="#783911"
                                app:cornerRadius="15dp"
                                app:icon="@android:drawable/ic_menu_send"
                                app:iconGravity="textEnd"
                                app:iconPadding="8dp"
                                app:iconTint="#F8F5EE"
                                app:rippleColor="#33FFFFFF" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ================================================= -->
            <!-- BOTTOM INFO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rewardsInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#E8DFD0"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="💡"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Every challenge counts"
                            android:textColor="#3F4935"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Complete challenges to keep building your reward balance."
                            android:textColor="#596447"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>