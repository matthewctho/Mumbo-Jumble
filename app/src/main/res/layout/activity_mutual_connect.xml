<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE6"
    android:fitsSystemWindows="true">

    <!-- ===================================================== -->
    <!-- BACKGROUND -->
    <!-- ===================================================== -->

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.2"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- ================================================= -->
            <!-- BACK -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:text="←  BACK"
                android:textColor="#783911"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEET A FELLOW HIKER"
                    android:textColor="#9B7054"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/mutualConnectTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mutual Connect"
                    android:textColor="#293126"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mutualConnectDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Meet another hiker on the trail. One of you shows a code, the other scans it."
                    android:textColor="#6E6A61"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- SAFETY / CONSENT BANNER -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#E8DED0"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#783911"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#FFF9F0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Points are only awarded once you BOTH confirm — never from a one-sided scan."
                        android:textColor="#293126"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- ACTION: SHOW MY QR CODE -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowQr"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:text="Show My QR Code"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFF9F0"
                app:backgroundTint="#783911"
                app:cornerRadius="18dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_qr_code"
                app:iconGravity="start"
                app:iconPadding="10dp"
                app:iconTint="#FFF9F0"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:text="Generate a code for the other hiker to scan"
                android:textColor="#6E6A61"
                android:textSize="9sp" />

            <!-- ================================================= -->
            <!-- ACTION: SCAN A QR CODE -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="Scan a QR Code"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFF9F0"
                app:backgroundTint="#34472B"
                app:cornerRadius="18dp"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="start"
                app:iconPadding="10dp"
                app:iconTint="#FFF9F0"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:text="Or scan your buddy's code with your camera"
                android:textColor="#6E6A61"
                android:textSize="9sp" />

            <!-- ================================================= -->
            <!-- QR CODE DISPLAY -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_qr_card"
                android:padding="16dp"
                android:elevation="6dp"
                android:visibility="gone"
                android:contentDescription="Your QR code" />

            <!-- ================================================= -->
            <!-- STATUS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/connectStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center"
                android:textColor="#293126"
                android:textSize="11sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <!-- ================================================= -->
            <!-- MOTIVATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="One scan, two hikers, zero solo photos."
                android:textColor="#783911"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
