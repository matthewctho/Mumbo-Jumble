<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hover / mouse -->
    <item android:state_hovered="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="180"
                android:valueTo="10dp"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleX"
                android:duration="180"
                android:valueTo="1.025"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleY"
                android:duration="180"
                android:valueTo="1.025"
                android:valueType="floatType" />
        </set>
    </item>

    <!-- Press -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="70"
                android:valueTo="2dp"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleX"
                android:duration="70"
                android:valueTo="0.97"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleY"
                android:duration="70"
                android:valueTo="0.97"
                android:valueType="floatType" />
        </set>
    </item>

    <!-- Default -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="180"
                android:valueTo="4dp"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleX"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />

            <objectAnimator
                android:propertyName="scaleY"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>

</selector>

